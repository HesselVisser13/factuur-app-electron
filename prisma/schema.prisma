// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model BtwTarief {
  id           Int       @id @default(autoincrement())
  naam         String
  percentage   Float
  geldigVanaf  DateTime
  geldigTot    DateTime?
  bron         String

  transacties   Transactie[]
  factuurRegels FactuurRegel[]
  offerteRegels  OfferteRegel[]

  createdAt    DateTime  @default(now())
}

model BtwSyncLog {
  id        Int      @id @default(autoincrement())
  bron      String
  succes    Boolean
  melding   String
  ruweData  String?
  checkedAt DateTime @default(now())
}

model Transactie {
  id            Int      @id @default(autoincrement())
  type          String
  omschrijving  String
  bedrag        Float
  invoerwijze   String

  btwTariefId   Int
  btwTarief     BtwTarief @relation(fields: [btwTariefId], references: [id])
  btwPercentage Float

  bedragExcl    Float
  btwBedrag     Float
  bedragIncl    Float

  datum         DateTime
  categorie     String?
  notitie       String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Klant {
  id             Int       @id @default(autoincrement())
  type           String    @default("particulier")  // "particulier" | "zakelijk"

  // Naam-velden
  bedrijfsnaam   String?   // alleen bij zakelijk verplicht
  aanhef         String?   // "Dhr." / "Mevr."
  voornaam       String?
  achternaam     String?

  // Contact
  adres          String?
  postcode       String?
  plaats         String?
  email          String?
  telefoon       String?

  // Alleen zakelijk
  kvkNummer      String?
  btwNummer      String?

  facturen       Factuur[]
  offertes       Offerte[]
  fotos     Foto[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Factuur {
  id             Int            @id @default(autoincrement())
  factuurNummer  String         @unique

  klantId        Int
  klant          Klant          @relation(fields: [klantId], references: [id])

  datum          DateTime
  vervalDatum    DateTime
  referentie     String?
  status         String         @default("concept")
  opmerkingen    String?

  totaalExcl     Float          @default(0)
  totaalBtw      Float          @default(0)
  totaalIncl     Float          @default(0)

  reistijdUren           Float?
  reistijdKm             Float?
  reistijdBedragExcl     Float?
  reistijdBtwBedrag      Float?
  reistijdBtwPercentage  Float?
  reistijdBtwTariefId    Int?
  reistijdOmschrijving   String?

  regels         FactuurRegel[]
  offerte        Offerte?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  mailLogs     MailLog[]
}

model FactuurRegel {
  id            Int       @id @default(autoincrement())
  factuurId     Int
  factuur       Factuur   @relation(fields: [factuurId], references: [id], onDelete: Cascade)

  datum         DateTime
  omschrijving  String
  aantal        Float
  prijsPerStuk  Float

  btwTariefId   Int
  btwTarief     BtwTarief @relation(fields: [btwTariefId], references: [id])
  btwPercentage Float

  bedragExcl    Float
  btwBedrag     Float
  bedragIncl    Float

  volgorde      Int       @default(0)
}

model Instelling {
  id     Int    @id @default(autoincrement())
  key    String @unique
  value  String
}

model MailLog {
  id           Int      @id @default(autoincrement())

  /** Exact één van factuurId / offerteId is gezet */
  factuurId    Int?
  factuur      Factuur? @relation(fields: [factuurId], references: [id], onDelete: Cascade)
  offerteId    Int?
  offerte      Offerte? @relation(fields: [offerteId], references: [id], onDelete: Cascade)

  verzondenOp  DateTime @default(now())
  ontvanger    String
  onderwerp    String
  body         String
  status       String
  errorMsg     String?
  messageId    String?

  @@index([factuurId])
  @@index([offerteId])
  @@index([verzondenOp])
}

model Foto {
  id           Int      @id @default(autoincrement())
  klantId      Int
  klant        Klant    @relation(fields: [klantId], references: [id], onDelete: Cascade)

  filename     String   // UUID-based, intern bestand op disk
  originalName String   // user-vriendelijke naam (voor weergave)
  bytes        Int      // bestandsgrootte
  takenAt      DateTime? // EXIF DateTimeOriginal
  notitie      String?  // optionele notitie

  createdAt    DateTime @default(now())

  @@index([klantId])
  @@index([createdAt])
}

model BackupLog {
  id        Int      @id @default(autoincrement())
  type      String   // 'manual' | 'auto'
  status    String   // 'success' | 'failed'
  filePath  String?  // null als status=failed
  bytes     Int?     // null als status=failed
  errorMsg  String?  // null als status=success
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

model Offerte {
  id             Int            @id @default(autoincrement())
  offerteNummer  String         @unique
  isPrijsopgave   Boolean  @default(false)

  klantId        Int
  klant          Klant          @relation(fields: [klantId], references: [id])

  datum          DateTime
  geldigTot      DateTime
  referentie     String?
  status         String         @default("concept")
  opmerkingen    String?
  toonAkkoordBlok Boolean       @default(false)

  totaalExcl     Float          @default(0)
  totaalBtw      Float          @default(0)
  totaalIncl     Float          @default(0)

  reistijdUren           Float?
  reistijdKm             Float?
  reistijdBedragExcl     Float?
  reistijdBtwBedrag      Float?
  reistijdBtwPercentage  Float?
  reistijdBtwTariefId    Int?
  reistijdOmschrijving   String?

  regels         OfferteRegel[]

  // Link bij omzetten naar factuur
  factuurId      Int?           @unique
  factuur        Factuur?       @relation(fields: [factuurId], references: [id])
  mailLogs       MailLog[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([klantId])
  @@index([status])
  @@index([datum])
}

model OfferteRegel {
  id            Int       @id @default(autoincrement())
  offerteId     Int
  offerte       Offerte   @relation(fields: [offerteId], references: [id], onDelete: Cascade)

  datum         DateTime
  omschrijving  String
  aantal        Float
  prijsPerStuk  Float

  btwTariefId   Int
  btwTarief     BtwTarief @relation(fields: [btwTariefId], references: [id])
  btwPercentage Float

  bedragExcl    Float
  btwBedrag     Float
  bedragIncl    Float

  volgorde      Int       @default(0)
}